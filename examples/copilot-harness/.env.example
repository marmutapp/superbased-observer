# Copy to a shell before `node app.mjs`, or set these in your environment.
# All values shown are the built-in defaults — you only need to override the model.

# Where the harness listens (loopback).
PORT=8090

# Observer node admission API (rides the dashboard listener on :8081).
ADMISSION_ENDPOINT=http://127.0.0.1:8081/api/obs/admission/check

# OpenAI-compatible base URL for answers. Pointing at the proxy's /up/ollama/
# prefix means every answer is captured in api_turns AND egress rules can apply.
# Bypass the proxy (no capture) with: http://127.0.0.1:11434/v1
PROXY_BASE=http://127.0.0.1:8820/up/ollama/v1

# The answering model. MUST match a tag from `ollama list` (e.g. qwen2.5:1.5b-instruct, gemma4:e4b).
ANSWER_MODEL=qwen2.5:1.5b-instruct

# Optional: emit OpenTelemetry spans so requests appear in web2 Trajectories.
# Requires `npm install` (pulls @opentelemetry/*). Leave off for the core demo.
ENABLE_OTEL=0
SUPERBASED_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Admission chunking + answer truncation (mirror the reference deployment).
CHUNK_BYTES=3500
CHUNK_OVERLAP=200
ANSWER_TRUNCATE=3000

# Timeouts (ms). A CPU-only Ollama judge is slow — keep these generous.
ADMIT_TIMEOUT_MS=45000
ANSWER_TIMEOUT_MS=120000
